# Application Configuration
NODE_ENV=development
PORT=3000
APP_NAME=Urbanity-Backend

# API Configuration
API_PREFIX=/api
API_VERSION=v1

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=false

# Swagger Documentation
SWAGGER_TITLE=Urbanity API
SWAGGER_DESCRIPTION=Urban Service Request & Issue Management Platform API
SWAGGER_VERSION=1.0.0

# Database Configuration (when implemented)
# DB_HOST=localhost
# DB_PORT=27017
# DB_NAME=urbanity
# DB_USER=admin
# DB_PASSWORD=password

# JWT Configuration
# Set a strong unique JWT_SECRET in each non-development environment.
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=1h

# Email Configuration (when implemented)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=your_email@gmail.com
# MAIL_PASS=your_app_password
# MAIL_FROM=noreply@urbanity.com

# File Upload Configuration
# MAX_FILE_SIZE=10485760
# ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# Logging
LOG_LEVEL=debug
