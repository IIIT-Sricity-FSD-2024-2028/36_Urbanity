# Optional local development configuration. Startup loads back-end/.env.
# Existing shell environment variables take precedence.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
JWT_EXPIRES_IN=1h
# Development has a built-in JWT secret. For production, set a strong unique
# JWT_SECRET in the deployment environment; it is required with NODE_ENV=production.
# JWT_SECRET=
# No database, API_PREFIX, API_VERSION or CORS_CREDENTIALS setting is used.
